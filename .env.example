# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional comma-separated list of Gemini API keys for Round-Robin load balancing:
# GEMINI_API_KEYS="KEY_1,KEY_2,KEY_3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDFLARE_GATEWAY_URL: Optional Cloudflare AI Gateway URL for Gemini caching/monitoring.
# Example: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/google-ai-studio
CLOUDFLARE_GATEWAY_URL=""

# RESEND_API_KEY: Optional Resend API key for emailing Magic Links and daily digests.
RESEND_API_KEY=""

# OWNER_EMAIL: Optional owner email address for daily parent registration digests.
OWNER_EMAIL=

# SECRET: HMAC-SHA256 secret used to sign payment entitlement tokens and parent session cookies.
SECRET=

# ADMIN_TOKEN: Admin authentication token for /admin, /api/admin/overview, and /api/admin/bank/generate (x-admin-token header).
ADMIN_TOKEN=

# ASAAS_API_KEY & ASAAS_WEBHOOK_TOKEN: Payment confirmation and webhook signature validation.
ASAAS_API_KEY=          # access_token do Asaas (Produção ou Sandbox)
ASAAS_WEBHOOK_TOKEN=    # Token configurado no painel Asaas > Integrações > Webhooks
ASAAS_ENV=sandbox       # 'sandbox' usa api-sandbox.asaas.com, 'production' usa api.asaas.com

# ASAAS_LINK_*: Optional static Asaas checkout URLs (fallback when dynamic paymentLinks are not used).
ASAAS_LINK_15S=
ASAAS_LINK_30S=
ASAAS_LINK_60S=
ASAAS_LINK_FAMILIA=
ASAAS_LINK_AUDIO=

# FIREBASE_SERVICE_ACCOUNT_JSON: JSON string or path to service-account.json for Firestore persistence.
FIREBASE_SERVICE_ACCOUNT_JSON=

# GEMINI_TTS_VOICE: Default Gemini TTS voice for Santa ('Algenib', 'Alnilam', 'Gacrux', 'Charon').
GEMINI_TTS_VOICE="Algenib"
